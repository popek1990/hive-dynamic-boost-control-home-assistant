# ---------------------------------------------------------------------------
#  Hive heating bot - configuration
#  Copy this file and fill it in:   cp .env.example .env && chmod 600 .env
#
#  Comments live on their own lines on purpose: a value may be followed by a
#  comment, but keeping them separate leaves no room for mistakes.
# ---------------------------------------------------------------------------

# Bot token from @BotFather in Telegram (/newbot).
TELEGRAM_TOKEN=

# Your own chat id, as a number. Strongly recommended.
# If you leave it empty, the FIRST person who sends /start claims this bot and
# will receive your house data. Find your id by messaging @userinfobot.
TELEGRAM_CHAT_ID=

# Home Assistant address and a long-lived access token
# (HA -> your profile -> Security -> Long-lived access tokens -> Create token).
# The bot only reads, but the token itself gives full API access: keep it secret
# and consider creating a separate, non-admin Home Assistant user for the bot.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- Language and time ---
# en or pl (add your own in messages.py)
BOT_LANG=en
# Any IANA zone, e.g. Europe/London, Europe/Warsaw. On a minimal image you may
# need the system 'tzdata' package.
BOT_TZ=Europe/London

# --- Alerting ---
# Alert when the house gets warmer than this, in degrees Celsius.
BOT_THRESHOLD_C=23.0
# How far it has to fall before the alarm re-arms.
BOT_HYSTERESIS_C=0.3
# How often to read the temperature, in seconds.
BOT_POLL_SEC=60
# Remind you while it is still too warm, in minutes (0 = never remind).
BOT_REPEAT_MIN=180

# --- Watchdogs ---
# Warn when the temperature reading has not changed for this many minutes.
# Hive only sends a new value when it actually changes, so a steady house looks exactly
# like a silent sensor. Measured over 30 days on a real install: the median gap between
# changes was 16 minutes, but twelve gaps were longer than 3 hours and the longest was
# 7.5 hours - all of them a calm house, not a fault. 45 minutes would have alerted 87
# times in a single week. Eight hours still catches a frozen integration or a hung Home
# Assistant, which last far longer than that.
BOT_STALE_SENSOR_MIN=480
# Warn after this many minutes without contact with Home Assistant.
BOT_HA_DOWN_MIN=10
# Port for the local /health endpoint (bound to 127.0.0.1 only).
BOT_HEALTH_PORT=8099
# Send a short message on start, so you can see the service came back after a reboot.
BOT_NOTIFY_ON_START=1

# --- History ---
# Hive drops to 'unavailable' for a couple of minutes at a time. A gap shorter
# than this that ends back in 'on' is counted as one run; a longer one ends the
# period. Set to 0 to never bridge a gap.
BOT_GAP_STITCH_MIN=5

# Optional: the hot-water window described in words, shown by /water.
# Leave empty to hide the line.
BOT_HW_SCHEDULE_TEXT=

# --- Entities (defaults match the Hive integration) ---
# Change these if your entity ids differ - check Developer Tools -> States.
BOT_ENTITY_TEMPERATURE=sensor.thermostat_1_current_temperature
BOT_ENTITY_TARGET=sensor.thermostat_1_target_temperature
BOT_ENTITY_MODE=sensor.thermostat_1_mode
BOT_ENTITY_CLIMATE=climate.thermostat_1
BOT_ENTITY_HEATING_STATE=binary_sensor.thermostat_1_state
BOT_ENTITY_BOOST_HEATING=binary_sensor.thermostat_1_boost
BOT_ENTITY_BOOST_WATER=binary_sensor.hotwater_boost
BOT_ENTITY_WATER_HEATER=water_heater.thermostat_1
